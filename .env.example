# Azure OpenAI / Foundry configuration. Copy to .env (git-ignored) and fill in.
# The Agent Framework does NOT load .env automatically — the package entry
# points call load_dotenv() explicitly.

# Resource ROOT, not the /api/projects/... project endpoint — the OpenAI client
# appends /openai/deployments/<name>/... to this base, so a project path 404s.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com

# The model deployment the agent calls. Must exist on the resource
# (portal: Models + endpoints → Deploy model, or az cognitiveservices
# account deployment create). Check your subscription's per-model quota first.
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5-mini

# Optional: data-plane API key. Leave unset to use managed identity /
# DefaultAzureCredential (the production hosted path).
AZURE_OPENAI_API_KEY=

# Local OTel tracing (task hosted:run / task devui). Points the OTel exporters
# at a local collector (task otel:up or task sim:up). Not needed in a real
# Foundry deployment, where the platform injects Application Insights wiring.
# The protocol line matters for the DevUI path: agent_framework's exporter
# defaults to gRPC, but the local collectors listen for OTLP http on :4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
