# Non-secret runtime config for the Foundry hosted agent, loaded explicitly by
# main.py (load_dotenv with override=False, so platform-registered env wins
# when present). Exists because agent-level env registration was witnessed not
# reaching session containers on azure.ai.agents 1.0.0-beta.6 (2026-07-22).
# NO SECRETS HERE — hosted auth is managed identity; the local dev key lives
# only in the git-ignored .env.
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_ENDPOINT=https://cog-h5axsks72x3km.openai.azure.com/
# chat: serve WorkflowChatAgent (plain-text turns — what the Foundry playground
# and azd invoke can render). workflow: the request_info function-call protocol
# for machine clients (see hosting.py module docstring).
HOSTED_AGENT_MODE=chat
